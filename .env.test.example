# Local test environment. Never put real credentials in this file.
#
# Tests prefer values reported by `supabase status -o env`.
# These loopback defaults exist only to make the expected target explicit.
# Any non-loopback host is rejected by scripts/guard-local.mjs.

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Do not hard-code keys here. Read them from the local stack:
#   npx supabase status -o env
SUPABASE_ANON_KEY=<local-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<local-service-role-key>
