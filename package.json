    "test:db:start": "node scripts/start-test-stack.mjs",
    "test:db:fast": "node scripts/test-db.mjs --no-reset",
    "test:integration": "node scripts/test-integration.mjs",
    "test:edge": "node scripts/test-edge.mjs",
    "test:all": "node scripts/test-all.mjs",
    "verify:migrations": "node scripts/verify-migrations.mjs",
    "verify:secrets": "node scripts/verify-secrets.mjs",
    "verify:blockers": "node scripts/verify-blockers.mjs",
