    "eslint": "^10.14.0",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "supabase": "^3.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
